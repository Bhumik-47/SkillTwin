# SkillTwin Environment Configuration

# ----------------------------------------------------
# Application Settings
# ----------------------------------------------------
ENVIRONMENT=development
PORT=8000
DEBUG=True

# ----------------------------------------------------
# Database Settings (PostgreSQL or SQLite fallback)
# ----------------------------------------------------
# For Local Docker PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/skilltwin
SYNC_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/skilltwin

# For Local SQLite (Zero-config fallback without Docker):
# DATABASE_URL=sqlite+aiosqlite:///./skilltwin.db
# SYNC_DATABASE_URL=sqlite:///./skilltwin.db

# ----------------------------------------------------
# JWT Authentication & Security
# ----------------------------------------------------
SECRET_KEY=skilltwin-super-secret-development-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------------------------------------------
# Google Gemini API (Required for Grounded Agents)
# ----------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
